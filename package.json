{
  "name": "palmsteeze",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:browser": "playwright test",
    "test:privacy": "playwright test --config=playwright.privacy.config.ts",
    "verify:turnstile": "tsx scripts/verify-turnstile.ts",
    "check:browser-secrets": "tsx scripts/check-browser-secrets.ts",
    "hosting:inspect": "tsx scripts/hosting.ts inspect",
    "hosting:prepare-worker": "tsx scripts/hosting.ts prepare-worker",
    "hosting:smoke": "tsx scripts/hosted-smoke.ts",
    "auth:inspect": "tsx scripts/auth-configuration.ts",
    "m2b:inspect": "tsx scripts/m2b-inspect.ts",
    "m2b:final-audit": "tsx scripts/m2b-final-audit.ts",
    "stripe:temporary": "tsx scripts/stripe-temporary.ts",
    "stripe:payment-proof": "tsx scripts/stripe-payment-proof.ts",
    "stripe:amount-proof": "tsx scripts/stripe-amount-proof.ts",
    "payments:prepare": "tsx scripts/payments-platform.ts prepare",
    "payments:enable-schedule": "tsx scripts/payments-platform.ts enable-schedule",
    "test:payment-schedule": "tsx scripts/payments-operational-proof.ts",
    "recovery:prepare": "tsx scripts/recovery-probe.ts prepare",
    "recovery:platform-proof": "tsx scripts/recovery-platform-proof.ts",
