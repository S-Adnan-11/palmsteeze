    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "description": "A Lagos coworking booking demo with transactional reservations and Stripe sandbox recovery.",
