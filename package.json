    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "test:db": "tsx tests/database/proof.ts",
    "test:payments": "tsx tests/database/payments.ts",
    "admin:assign": "tsx scripts/assign-admin.ts",
    "test:admin-db": "tsx tests/database/admin.ts",
    "m3:final-audit": "tsx scripts/m3-final-audit.ts",
