  "dependencies": {
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-select": "2.3.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "animejs": "4.5.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "23.0.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
