# Reconfirm this existing project's Free plan/usage in its dashboard.
PALMSTEEZE_DB_DEDICATED=true
PALMSTEEZE_DB_FREE_CONFIRMED=true
# Existing opaque token from the private workspace; server-only and sensitive.
PALMSTEEZE_PAYMENT_WORKER_TOKEN=
