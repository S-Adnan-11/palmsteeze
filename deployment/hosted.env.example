# Application variables only. Enter matching environment values; never upload .env.local.
APP_ORIGIN=https://palmsteeze.devs.surf
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
PALMSTEEZE_DB_DEDICATED=true
PALMSTEEZE_DB_FREE_CONFIRMED=true
# Server-only recovery credential for the existing worker.
PALMSTEEZE_PAYMENT_WORKER_TOKEN=
# Genuine matching hosted widget; exact hostname, no pre-clearance or test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Server-only 32-byte lowercase hex key, matching database signing configuration.
PALMSTEEZE_SECURITY_SECRET=
PALMSTEEZE_TURNSTILE_TEST_MODE=false
# Excludes database passwords, service/Management keys, Google and Stripe secrets.
