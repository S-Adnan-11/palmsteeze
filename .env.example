# Copy to .env.local and fill privately. Never commit .env.local.
# Local development/tooling template. Do not import this whole file into hosting.
# Hosting uses only the application variables in deployment/hosted.env.example.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
# Keep this canonical development default. Exact localhost + tunnel origins live
# in supabase/functions/_shared/application-origins.ts.
# Server-only random 32-byte lowercase hex key. Provision matching private DB config
# with verified migration tooling. Never expose through NEXT_PUBLIC variables.
PALMSTEEZE_SECURITY_SECRET=

# Dedicated Free project: copy its nonsecret reference from Supabase Dashboard.
SUPABASE_PROJECT_REF=
PALMSTEEZE_DB_DEDICATED=false
PALMSTEEZE_DB_FREE_CONFIRMED=false

# Connect > Session pooler, port 5432. Separate fields avoid URL escaping/TLS overrides.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=
DATABASE_PASSWORD=
# Optional certificate file if your project requires a CA not in Node's trust store.
# Download the CA from the project's official Connect/database settings.
# Set a project-relative path to the downloaded CA file.
DATABASE_CA_FILE=

# For verifying the project's name/status with the Supabase Management API.
# Create a personal access token privately at https://supabase.com/dashboard/account/tokens.
# Required by db:inspect/db:migrate; never exposed to the browser.
SUPABASE_ACCESS_TOKEN=

# Only used by the integration test runner to create/delete legitimate Auth test users.
# Project Settings > API Keys > server-side secret key (legacy service_role also supported).
SUPABASE_SECRET_KEY=

# Dedicated Stripe sandbox only; never use live-mode credentials.
# Stripe Dashboard > account picker > Sandboxes > PalmSteeze Development > API keys.
# Use a restricted sandbox key with Checkout Sessions / PaymentIntents / Charges /
# Refunds / Events and webhook-endpoint permissions needed by the proof.
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
PALMSTEEZE_STRIPE_SANDBOX_CONFIRMED=true
# Captured privately by webhook tooling; never a NEXT_PUBLIC variable.
STRIPE_WEBHOOK_SECRET=
PALMSTEEZE_PAYMENT_WORKER_TOKEN=
# Only if a temporary CLI sandbox is needed: your chosen claim email, filled privately.
# No email is inferred from Google identities, Git config or unrelated projects.
STRIPE_SANDBOX_EMAIL=

# Explicit admin assignment tooling only. Fill exactly one identifier privately.
# Account must already be a verified Google identity. No first-user promotion.
PALMSTEEZE_OWNER_ADMIN_EMAIL=
PALMSTEEZE_OWNER_ADMIN_USER_ID=

# Use matching Managed-mode keys for each exact development hostname.
# Keep hostname configuration aligned with the explicit origin allowlist.
# Keep pre-clearance disabled. Keys are entered only in ignored .env.local.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Official dummy keys require true AND a loopback APP_ORIGIN. Never enable hosted.
PALMSTEEZE_TURNSTILE_TEST_MODE=false
